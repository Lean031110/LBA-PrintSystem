# Copiar a .env junto a docker-compose.yml (nunca al repositorio).
# Los valores vacíos hacen que la BD genere credenciales aleatorias en el
# primer arranque y las escriba en /data/initial_credentials.txt.
LBA_IMAGE=ghcr.io/lean031110/lba-print-system:1.0.0
LBA_PORT=8000
LBA_SIM_PORT=9910
# Opcionales: fíjelos para aprovisionar credenciales conocidas (mín. 12/32).
LBA_ADMIN_PASSWORD=
LBA_API_TOKEN=
