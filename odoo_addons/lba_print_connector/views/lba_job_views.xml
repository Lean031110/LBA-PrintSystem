<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lba_job_tree" model="ir.ui.view">
        <field name="name">lba.print.job.tree</field>
        <field name="model">lba.print.job</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'sent'"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'pending'">
                <field name="create_date" string="Creado"/>
                <field name="kind"/>
                <field name="order_ref" string="Pedido"/>
                <field name="department_id"/>
                <field name="printer_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'pending'"/>
                <field name="attempts" string="Intentos"/>
                <field name="next_attempt" string="Próximo intento"
                       optional="hide"/>
                <field name="external_job_id" optional="hide"/>
                <field name="sent_at" optional="hide"/>
                <field name="last_error" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_lba_job_form" model="ir.ui.view">
        <field name="name">lba.print.job.form</field>
        <field name="model">lba.print.job</field>
        <field name="arch" type="xml">
            <form string="Trabajo LBA">
                <header>
                    <button name="action_process_now" type="object"
                            string="Procesar ahora"
                            groups="point_of_sale.group_pos_manager"
                            invisible="state != 'pending'" icon="fa-play"/>
                    <button name="action_retry" type="object"
                            string="Reintentar"
                            groups="point_of_sale.group_pos_manager"
                            invisible="state != 'failed'" icon="fa-undo"/>
                    <button name="action_cancel" type="object"
                            string="Cancelar"
                            groups="point_of_sale.group_pos_manager"
                            invisible="state != 'pending'" icon="fa-ban"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,sent,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="uuid" readonly="1"/>
                            <field name="kind"/>
                            <field name="order_ref"/>
                            <field name="order_uuid" readonly="1"/>
                            <field name="department_id"/>
                            <field name="printer_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="max_attempts"/>
                            <field name="next_attempt" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                            <field name="external_job_id" readonly="1"/>
                            <field name="idempotency_key" readonly="1"/>
                        </group>
                    </group>
                    <group string="Último error">
                        <field name="last_error" readonly="1"/>
                    </group>
                    <group string="Payload (documento estructurado)">
                        <field name="payload_json" readonly="1"
                               widget="ace" options="{'mode': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lba_job_search" model="ir.ui.view">
        <field name="name">lba.print.job.search</field>
        <field name="model">lba.print.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_ref" string="Pedido"/>
                <field name="order_uuid"/>
                <filter name="f_pending" string="Pendientes"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="f_failed" string="Fallidos"
                        domain="[('state', '=', 'failed')]"/>
                <filter name="f_sent" string="Enviados"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="f_receipt" string="Recibos"
                        domain="[('kind', '=', 'receipt')]"/>
                <filter name="f_delta" string="Cambios/Cancelaciones"
                        domain="[('kind', 'in', ('delta', 'kitchen'))]"/>
                <separator/>
                <filter name="g_state" string="Agrupar por estado"
                        context="{'group_by': 'state'}"/>
                <filter name="g_printer" string="Agrupar por impresora"
                        context="{'group_by': 'printer_id'}"/>
                <filter name="g_kind" string="Agrupar por tipo"
                        context="{'group_by': 'kind'}"/>
            </search>
        </field>
    </record>

    <record id="action_lba_job" model="ir.actions.act_window">
        <field name="name">Cola de trabajos LBA</field>
        <field name="res_model">lba.print.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
