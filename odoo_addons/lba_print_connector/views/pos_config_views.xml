<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TPV: pestaña de impresión LBA DENTRO del notebook del formulario
         de pos.config (Odoo 19: sheet > notebook > page). -->
    <record id="view_pos_config_form_lba" model="ir.ui.view">
        <field name="name">pos.config.form.lba</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet//notebook" position="inside">
                <page string="Impresión LBA" name="lba_print">
                    <group>
                        <group string="LBA Print Server">
                            <field name="lba_active"
                                   string="Imprimir recibos y comandas por LBA"/>
                            <field name="lba_receipt_printer_id"
                                   invisible="not lba_active"
                                   options="{'no_create': True}"/>
                            <field name="lba_server_id"
                                   invisible="not lba_active"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="text-muted" colspan="2">
                        <p>Las comandas se enrutan por departamentos
                        (categoría POS → departamento → impresora) en
                        Punto de venta → Configuración → LBA Print →
                        Departamentos. Las plantillas de tickets se editan en
                        LBA Print → Plantillas de impresión. Para conectar el
                        servidor, usa el menú LBA Print → Servidor (URL,
                        puerto y token del panel).</p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
