<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla: cada empresa ve sus propios servidores/impresoras/cola -->
        <record id="lba_server_company_rule" model="ir.rule">
            <field name="name">LBA server: multi-compañía</field>
            <field name="model_id" ref="model_lba_print_server"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
        </record>
        <record id="lba_printer_company_rule" model="ir.rule">
            <field name="name">LBA printer: multi-compañía</field>
            <field name="model_id" ref="model_lba_print_printer"/>
            <field name="domain_force">[('server_id.company_id', '=', company_id)]</field>
        </record>
        <record id="lba_job_company_rule" model="ir.rule">
            <field name="name">LBA job: multi-compañía</field>
            <field name="model_id" ref="model_lba_print_job"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
        </record>
    </data>
</odoo>
