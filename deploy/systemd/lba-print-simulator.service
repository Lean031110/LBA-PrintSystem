[Unit]
Description=LBA Print Server — simulador ESC/POS (impresora falsa de red)
Documentation=https://github.com/LBA-PrintSystem
After=network-online.target

[Service]
Type=simple
User=lba
Group=lba
WorkingDirectory=/opt/lba/server
EnvironmentFile=-/etc/lba-print/lba-print.env
ExecStart=/opt/lba/server/.venv/bin/python -m app.drivers.simulator --host 127.0.0.1 --port ${LBA_SIM_PORT}
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lba
ProtectHome=true

[Install]
WantedBy=multi-user.target
